{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsheng-task-reconcile-v1",
  "title": "Task candidate reconciliation v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "analysis_revision_no": {
      "type": "integer",
      "minimum": 1
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_generation_id": {
      "type": "string",
      "format": "uuid"
    },
    "candidate_revision_no": {
      "type": "integer",
      "minimum": 1
    },
    "expected_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "task_revision_no": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "task_id",
          "task_revision_no"
        ]
      }
    },
    "mutation_id": {
      "type": "string",
      "format": "uuid"
    },
    "mappings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "candidate_task_key": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "const": "new"
              }
            },
            "required": [
              "candidate_task_key",
              "action"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "candidate_task_key": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "const": "ignore"
              }
            },
            "required": [
              "candidate_task_key",
              "action"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "candidate_task_key": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "const": "replace"
              },
              "existing_task_id": {
                "type": "string",
                "format": "uuid"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "candidate_task_key",
              "action",
              "existing_task_id",
              "reason"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "candidate_task_key": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "const": "update"
              },
              "existing_task_id": {
                "type": "string",
                "format": "uuid"
              },
              "take_fields": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "title",
                    "summary",
                    "category",
                    "metric_id",
                    "baseline",
                    "target_period",
                    "target_value",
                    "unit",
                    "owner",
                    "planned_start",
                    "due_date",
                    "resource_need",
                    "success_criteria",
                    "evidence_ids",
                    "assumptions",
                    "needs_review"
                  ]
                }
              },
              "step_mappings": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "candidate_step_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "action": {
                          "const": "new"
                        }
                      },
                      "required": [
                        "candidate_step_id",
                        "action"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "candidate_step_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "action": {
                          "const": "update"
                        },
                        "existing_step_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "take_fields": {
                          "type": "array",
                          "uniqueItems": true,
                          "items": {
                            "enum": [
                              "action",
                              "owner",
                              "start_date",
                              "due_date",
                              "done_criteria",
                              "evidence_ids"
                            ]
                          }
                        }
                      },
                      "required": [
                        "candidate_step_id",
                        "action",
                        "existing_step_id",
                        "take_fields"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "candidate_step_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "action": {
                          "const": "ignore"
                        }
                      },
                      "required": [
                        "candidate_step_id",
                        "action"
                      ]
                    }
                  ]
                }
              },
              "remove_existing_step_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "final_step_order": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "existing"
                        },
                        "step_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      },
                      "required": [
                        "kind",
                        "step_id"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "new_candidate"
                        },
                        "candidate_step_id": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "candidate_step_id"
                      ]
                    }
                  ]
                }
              }
            },
            "required": [
              "candidate_task_key",
              "action",
              "existing_task_id",
              "take_fields",
              "step_mappings",
              "remove_existing_step_ids",
              "final_step_order"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "workspace_id",
    "run_id",
    "analysis_revision_no",
    "input_fingerprint",
    "candidate_generation_id",
    "candidate_revision_no",
    "expected_tasks",
    "mutation_id",
    "mappings"
  ],
  "description": "Pure local apply contract; mappings cover every candidate exactly once. Unmapped old tasks survive. No model matching. See lifecycle spec for cross-object uniqueness, optimistic concurrency, field-selection and atomicity."
}
