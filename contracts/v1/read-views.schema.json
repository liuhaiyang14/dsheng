{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsheng-read-views-v1",
  "title": "dsheng read-side output views v1",
  "description": "Read-only command output contracts for CLI/UI shared views. Approved additive extension 2026-11-02 (user decision) to close the read-side contract gap reported by the UI work package. Business values are canonical decimal strings; no float conversion. Fields follow task-lifecycle.md §7 and data-period-import.md §1.4; presentational classifications stay client-side.",
  "$defs": {
    "decimalString": {
      "type": ["string", "null"],
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
      "description": "Canonical decimal string or null; no exponent/grouping/leading zeros/trailing fractional zeros/negative zero. Fraction-digit caps (input 6 / division 12 / progress 2) are enforced by the core, not by this pattern."
    },
    "progressString": {
      "type": "string",
      "pattern": "^(?:(?:0|[1-9][0-9]?)(?:\\.[0-9]?[1-9])?|100)$"
    },
    "uuidString": { "type": "string", "format": "uuid" },
    "isoDate": { "type": ["string", "null"], "format": "date" },
    "isoDateTime": { "type": ["string", "null"], "format": "date-time" },
    "dateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/isoDate" },
        "to": { "$ref": "#/$defs/isoDate" }
      }
    },
    "taskStatus": { "enum": ["not_started", "in_progress", "completed", "blocked"] },
    "taskLifecycle": { "enum": ["active", "superseded"] },
    "progressMode": { "enum": ["auto", "manual"] },
    "smartStatus": { "enum": ["generated", "stale"] },
    "taskCategory": { "enum": ["revenue", "cost", "efficiency", "other"] },
    "actorSource": { "enum": ["ui", "cli", "import", "generation"] },
    "cadence": { "enum": ["day", "week", "month", "quarter"] },
    "direction": { "enum": ["up", "down", "neutral"] },
    "availability": { "enum": ["available", "partial", "unavailable"] },

    "scanFileInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_id", "file_label", "row_count", "sheet_count", "mapping_status", "note"],
      "properties": {
        "file_id": { "type": "string", "minLength": 1 },
        "file_label": { "type": "string", "minLength": 1 },
        "row_count": { "type": "integer", "minimum": 0 },
        "sheet_count": { "type": "integer", "minimum": 0 },
        "mapping_status": { "enum": ["mapped", "pending_review"] },
        "note": { "type": ["string", "null"] }
      }
    },
    "scanSummaryView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "directory_label", "scanned_at", "files", "total_rows", "coverage", "pending_inputs"],
      "properties": {
        "workspace_id": { "$ref": "#/$defs/uuidString" },
        "directory_label": { "type": "string", "minLength": 1 },
        "scanned_at": { "$ref": "#/$defs/isoDateTime" },
        "files": { "type": "array", "items": { "$ref": "#/$defs/scanFileInfo" } },
        "total_rows": { "type": "integer", "minimum": 0 },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to", "granularity"],
          "properties": {
            "from": { "$ref": "#/$defs/isoDate" },
            "to": { "$ref": "#/$defs/isoDate" },
            "granularity": { "$ref": "#/$defs/cadence" }
          }
        },
        "pending_inputs": { "type": "array", "items": { "type": "string" } },
        "source_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile_id", "version", "hash", "mode"],
          "properties": {
            "profile_id": { "type": "string", "minLength": 1 },
            "version": { "type": "integer", "minimum": 1 },
            "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "mode": { "type": "string", "minLength": 1 },
            "profile_ref": { "type": ["string", "null"] }
          }
        }
      }
    },
    "fieldMappingView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_field", "source_label", "recognized", "usage"],
      "properties": {
        "tool_field": { "type": "string", "minLength": 1 },
        "source_label": { "type": "string" },
        "recognized": { "type": "string" },
        "usage": { "type": "string" }
      }
    },

    "comparisonView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_type", "label", "base_from", "base_to", "base_value", "absolute_change", "change_rate", "availability_status", "reason", "base_refs", "evidence_ids"],
      "properties": {
        "comparison_type": { "enum": ["mom", "yoy"] },
        "label": { "type": "string", "minLength": 1 },
        "base_from": { "$ref": "#/$defs/isoDate" },
        "base_to": { "$ref": "#/$defs/isoDate" },
        "base_value": { "$ref": "#/$defs/decimalString" },
        "absolute_change": { "$ref": "#/$defs/decimalString" },
        "change_rate": { "$ref": "#/$defs/decimalString" },
        "availability_status": { "$ref": "#/$defs/availability" },
        "reason": { "type": ["string", "null"] },
        "base_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["run_id", "revision_no"],
            "properties": {
              "run_id": { "$ref": "#/$defs/uuidString" },
              "revision_no": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "metricRowView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "metric_key", "metric_label", "unit", "direction", "target_value", "actual_value", "delta", "status", "pending_reasons", "mom", "yoy"],
      "properties": {
        "metric_id": { "$ref": "#/$defs/uuidString" },
        "metric_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "metric_label": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "direction": { "$ref": "#/$defs/direction" },
        "target_value": { "$ref": "#/$defs/decimalString" },
        "actual_value": { "$ref": "#/$defs/decimalString" },
        "delta": { "$ref": "#/$defs/decimalString", "description": "actual - target；缺任一操作数为 null" },
        "status": { "enum": ["ready", "pending"] },
        "pending_reasons": { "type": "array", "items": { "type": "string" } },
        "mom": { "oneOf": [{ "$ref": "#/$defs/comparisonView" }, { "type": "null" }] },
        "yoy": { "oneOf": [{ "$ref": "#/$defs/comparisonView" }, { "type": "null" }] }
      }
    },
    "metricSeriesView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_key", "metric_label", "unit", "buckets", "actual", "plan", "delta", "composition"],
      "properties": {
        "metric_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "metric_label": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "buckets": { "type": "array", "items": { "type": "string" } },
        "actual": { "type": "array", "items": { "$ref": "#/$defs/decimalString" }, "description": "与 buckets 对齐；缺桶 null，不插值" },
        "plan": { "type": "array", "items": { "$ref": "#/$defs/decimalString" } },
        "delta": { "type": ["array", "null"], "items": { "$ref": "#/$defs/decimalString" }, "description": "逐桶差异由核心计算；不适用为 null" },
        "composition": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "value": { "$ref": "#/$defs/decimalString" }
            }
          }
        }
      }
    },
    "analysisRunView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "run_id", "period", "current_revision_no", "analysis_input_fingerprint", "grain", "metrics", "series"],
      "properties": {
        "workspace_id": { "$ref": "#/$defs/uuidString" },
        "run_id": { "$ref": "#/$defs/uuidString" },
        "period": { "$ref": "#/$defs/dateRange" },
        "current_revision_no": { "type": "integer", "minimum": 1 },
        "analysis_input_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "two_tables_ready": { "type": "boolean" },
        "grain": { "$ref": "#/$defs/cadence" },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/metricRowView" } },
        "series": { "type": "array", "items": { "$ref": "#/$defs/metricSeriesView" } },
        "source_profile": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["profile_id", "version", "hash", "mode"],
          "properties": {
            "profile_id": { "type": "string", "minLength": 1 },
            "version": { "type": "integer", "minimum": 1 },
            "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "mode": { "type": "string", "minLength": 1 },
            "profile_ref": { "type": ["string", "null"] },
            "config": { "type": ["object", "null"] }
          }
        }
      }
    },

    "smartCheckView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smart_status", "assessed_task_revision", "checks"],
      "properties": {
        "smart_status": { "$ref": "#/$defs/smartStatus" },
        "assessed_task_revision": { "type": "integer", "minimum": 1 },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension", "status", "note"],
            "properties": {
              "dimension": { "enum": ["S", "M", "A", "R", "T"] },
              "status": { "enum": ["met", "needs_confirmation", "not_applicable"] },
              "note": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "taskStepView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "step_order", "action", "owner", "start_date", "due_date", "done_criteria", "status", "blocked_reason", "completed_at"],
      "properties": {
        "step_id": { "$ref": "#/$defs/uuidString" },
        "step_order": { "type": "integer", "minimum": 1 },
        "action": { "type": "string", "minLength": 1 },
        "owner": { "type": ["string", "null"] },
        "start_date": { "$ref": "#/$defs/isoDate" },
        "due_date": { "$ref": "#/$defs/isoDate" },
        "done_criteria": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/taskStatus" },
        "blocked_reason": { "type": ["string", "null"] },
        "completed_at": { "$ref": "#/$defs/isoDateTime" }
      }
    },
    "taskEvidenceView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_label", "locator", "analysis_revision_no"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "source_label": { "type": "string", "minLength": 1 },
        "locator": { "type": "string" },
        "analysis_revision_no": { "type": "integer", "minimum": 1 }
      }
    },
    "taskEventView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "task_id", "task_revision_no", "event_seq", "kind", "reason", "actor_source", "occurred_at"],
      "properties": {
        "event_id": { "$ref": "#/$defs/uuidString" },
        "task_id": { "$ref": "#/$defs/uuidString" },
        "task_revision_no": { "type": "integer", "minimum": 1 },
        "event_seq": { "type": "integer", "minimum": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "reason": { "type": ["string", "null"] },
        "actor_source": { "$ref": "#/$defs/actorSource" },
        "occurred_at": { "$ref": "#/$defs/isoDateTime" }
      }
    },
    "taskView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id", "task_id", "task_revision_no", "title", "summary", "category",
        "metric_id", "metric_label", "target_value", "planned_value", "actual_value",
        "current_value", "unit", "mp_label", "mp_unit", "owner", "planned_start",
        "due_date", "resource_need", "success_criteria", "note", "review_note",
        "target_period", "lifecycle", "status", "progress", "progress_mode",
        "adjustment_reason", "blocked_reason", "completed_at", "smart_check",
        "steps", "evidence", "events", "origin_run_id", "overdue"
      ],
      "properties": {
        "workspace_id": { "$ref": "#/$defs/uuidString" },
        "task_id": { "$ref": "#/$defs/uuidString" },
        "task_revision_no": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "category": { "$ref": "#/$defs/taskCategory" },
        "metric_id": { "oneOf": [{ "$ref": "#/$defs/uuidString" }, { "type": "null" }] },
        "metric_label": { "type": ["string", "null"] },
        "target_value": { "$ref": "#/$defs/decimalString" },
        "planned_value": { "$ref": "#/$defs/decimalString" },
        "actual_value": { "$ref": "#/$defs/decimalString" },
        "current_value": { "$ref": "#/$defs/decimalString" },
        "unit": { "type": ["string", "null"] },
        "mp_label": { "type": ["string", "null"] },
        "mp_unit": { "type": ["string", "null"] },
        "owner": { "type": ["string", "null"] },
        "planned_start": { "$ref": "#/$defs/isoDate" },
        "due_date": { "$ref": "#/$defs/isoDate" },
        "resource_need": { "type": ["string", "null"] },
        "success_criteria": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] },
        "review_note": { "type": ["string", "null"] },
        "target_period": { "oneOf": [{ "$ref": "#/$defs/dateRange" }, { "type": "null" }] },
        "lifecycle": { "$ref": "#/$defs/taskLifecycle" },
        "status": { "$ref": "#/$defs/taskStatus" },
        "progress": { "$ref": "#/$defs/progressString" },
        "progress_mode": { "$ref": "#/$defs/progressMode" },
        "adjustment_reason": { "type": ["string", "null"] },
        "blocked_reason": { "type": ["string", "null"] },
        "completed_at": { "$ref": "#/$defs/isoDateTime" },
        "smart_check": { "$ref": "#/$defs/smartCheckView" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/taskStepView" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/taskEvidenceView" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/taskEventView" } },
        "origin_run_id": { "oneOf": [{ "$ref": "#/$defs/uuidString" }, { "type": "null" }] },
        "overdue": { "type": "boolean", "description": "派生：当地 today>due_date 且 status!=completed 且 lifecycle=active" }
      }
    },
    "taskCandidateView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_generation_id", "candidate_revision_no", "run_id", "analysis_revision_no", "state", "envelope_locally_reconstructed", "tasks"],
      "properties": {
        "candidate_generation_id": { "$ref": "#/$defs/uuidString" },
        "candidate_revision_no": { "type": "integer", "minimum": 1 },
        "run_id": { "$ref": "#/$defs/uuidString" },
        "analysis_revision_no": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["candidate", "applied", "discarded"] },
        "envelope_locally_reconstructed": { "type": "boolean" },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_key", "title", "summary", "category", "target_value", "owner", "steps"],
            "properties": {
              "task_key": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "summary": { "type": "string" },
              "category": { "$ref": "#/$defs/taskCategory" },
              "target_value": { "$ref": "#/$defs/decimalString" },
              "owner": { "type": ["string", "null"] },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["step_id", "action"],
                  "properties": {
                    "step_id": { "type": "string", "minLength": 1 },
                    "action": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "timelineEntryView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "task_title", "kind", "date", "occurred_at", "detail"],
      "properties": {
        "task_id": { "$ref": "#/$defs/uuidString" },
        "task_title": { "type": "string" },
        "kind": { "enum": ["planned_start", "due", "completed", "progress_event"] },
        "date": { "$ref": "#/$defs/isoDate", "description": "null=未设置，不参与日期排序" },
        "occurred_at": { "$ref": "#/$defs/isoDateTime" },
        "detail": { "type": "string" }
      }
    },
    "historyEntryView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "workspace_id", "period", "period_key", "cadence", "policy_version", "current_revision_no", "updated_at", "summary", "task_snapshot_no"],
      "properties": {
        "run_id": { "$ref": "#/$defs/uuidString" },
        "workspace_id": { "$ref": "#/$defs/uuidString" },
        "period": { "$ref": "#/$defs/dateRange" },
        "period_key": { "type": "string", "minLength": 1 },
        "cadence": { "$ref": "#/$defs/cadence" },
        "policy_version": { "type": "integer", "minimum": 1 },
        "current_revision_no": { "type": "integer", "minimum": 1 },
        "updated_at": { "$ref": "#/$defs/isoDateTime" },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric_count", "task_count", "chart_count"],
          "properties": {
            "metric_count": { "type": "integer", "minimum": 0 },
            "task_count": { "type": "integer", "minimum": 0 },
            "chart_count": { "type": "integer", "minimum": 0 }
          }
        },
        "task_snapshot_no": { "type": "integer", "minimum": 0 }
      }
    },
    "historyDetailView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "analysis_revision_no", "task_snapshot_no", "captured_at", "metrics", "series", "grain", "period", "tasks"],
      "properties": {
        "run_id": { "$ref": "#/$defs/uuidString" },
        "analysis_revision_no": { "type": "integer", "minimum": 1 },
        "analysis_input_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "task_plan_period": { "anyOf": [{ "$ref": "#/$defs/dateRange" }, { "type": "null" }] },
        "two_tables_ready": { "type": "boolean" },
        "task_snapshot_no": { "type": "integer", "minimum": 0 },
        "captured_at": { "$ref": "#/$defs/isoDateTime" },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/metricRowView" } },
        "series": { "type": "array", "items": { "$ref": "#/$defs/metricSeriesView" } },
        "grain": { "$ref": "#/$defs/cadence" },
        "period": { "$ref": "#/$defs/dateRange" },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "title", "status", "progress", "task_revision_no"],
            "properties": {
              "task_id": { "$ref": "#/$defs/uuidString" },
              "title": { "type": "string" },
              "status": { "$ref": "#/$defs/taskStatus" },
              "progress": { "$ref": "#/$defs/progressString" },
              "task_revision_no": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "diagnosisReportVersionView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "run_id", "analysis_revision_no", "report_revision_no", "version_no", "created_at"],
      "properties": {
        "report_id": { "$ref": "#/$defs/uuidString" },
        "run_id": { "$ref": "#/$defs/uuidString" },
        "analysis_revision_no": { "type": "integer", "minimum": 1 },
        "report_revision_no": { "type": "integer", "minimum": 1 },
        "version_no": { "type": "integer", "minimum": 1 },
        "created_at": { "$ref": "#/$defs/isoDateTime" }
      }
    },
    "diagnosisReportSummaryView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "workspace_id", "run_id", "analysis_revision_no", "framework", "problem_statement", "report_revision_no", "state", "stop_reason", "can_continue", "active_warning_count", "created_at", "updated_at", "series_id", "version_no", "is_latest", "referenceable", "versions"],
      "properties": {
        "report_id": { "$ref": "#/$defs/uuidString" },
        "workspace_id": { "$ref": "#/$defs/uuidString" },
        "run_id": { "$ref": "#/$defs/uuidString" },
        "analysis_revision_no": { "type": "integer", "minimum": 1 },
        "framework": { "enum": ["5why", "5w", "5w2h"] },
        "problem_statement": { "type": "string", "minLength": 1 },
        "report_revision_no": { "type": "integer", "minimum": 1 },
        "state": { "type": "string", "minLength": 1 },
        "stop_reason": { "type": ["string", "null"] },
        "can_continue": { "type": "boolean" },
        "active_warning_count": { "type": "integer", "minimum": 0 },
        "created_at": { "$ref": "#/$defs/isoDateTime" },
        "updated_at": { "$ref": "#/$defs/isoDateTime" },
        "series_id": { "$ref": "#/$defs/uuidString" },
        "version_no": { "type": "integer", "minimum": 1 },
        "is_latest": { "type": "boolean" },
        "referenceable": { "type": "boolean" },
        "versions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/diagnosisReportVersionView" } }
      }
    },
    "reconcilePreviewView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apply_token", "expires_at", "affected", "created_new", "ignored", "replaced"],
      "properties": {
        "apply_token": { "$ref": "#/$defs/uuidString" },
        "expires_at": { "$ref": "#/$defs/isoDateTime" },
        "affected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "task_revision_no", "action"],
            "properties": {
              "task_id": { "$ref": "#/$defs/uuidString" },
              "task_revision_no": { "type": "integer", "minimum": 1 },
              "action": { "enum": ["new", "update", "replace", "ignore"] }
            }
          }
        },
        "created_new": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "ignored": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "replaced": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
