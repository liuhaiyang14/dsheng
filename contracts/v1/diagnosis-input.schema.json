              "tax_basis": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dimension": {
                "const": "ratio"
              }
            }
          },
          "then": {
            "properties": {
              "base_unit": {
                "const": "1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dimension": {
                "const": "time"
              }
            }
