{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsheng-diagnosis-input-v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_schema_version": {
          "const": "2"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "analysis_revision_no": {
          "type": "integer",
          "minimum": 1
        },
        "analysis_input_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prompt_version": {
          "const": "2.0"
        },
        "workflow": {
          "const": "diagnosis"
        },
        "report_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "generation_session_id": {
          "type": "string",
          "minLength": 1
        },
        "round_no": {
          "type": "integer",
          "minimum": 1
        },
        "framework": {
          "enum": [
            "5why",
            "5w",
            "5w2h"
          ]
        },
        "schema_version": {
          "const": "3"
        },
        "user_confirmed_continue": {
          "type": "boolean"
        },
        "context_policy_version": {
          "const": "2"
        }
      },
      "required": [
        "input_schema_version",
        "run_id",
        "analysis_revision_no",
        "analysis_input_fingerprint",
        "prompt_version",
        "workflow",
        "report_id",
        "generation_session_id",
        "round_no",
        "framework",
        "schema_version",
        "user_confirmed_continue",
        "context_policy_version"
      ]
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "source_manifest": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceManifest"
      }
    },
    "source_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceRecord"
      }
    },
    "manual_inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manualInput"
      }
    },
    "missing_or_anomalous_inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anomaly"
      }
    },
    "source_conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_from": {
          "type": "string",
          "format": "date"
        },
        "source_to": {
          "type": "string",
          "format": "date"
        },
        "period_policy_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_from",
        "source_to",
        "period_policy_version"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "problem_statement": {
          "type": "string",
          "minLength": 1
        },
        "focus_metric_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 1
        },
        "framework": {
          "enum": [
            "5why",
            "5w",
            "5w2h"
          ]
        },
        "open_question_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "problem_statement",
        "focus_metric_ids",
        "framework",
        "open_question_ids"
      ]
    },
    "user_message": {
      "type": "string",
      "maxLength": 8000
    },
    "continuation_input": {
      "anyOf": [
        {
          "$ref": "#/$defs/continuation"
        },
        {
          "type": "null"
        }
      ]
    },
    "session_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepted_facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptedFact"
          }
        },
        "prior_report_summary": {
          "anyOf": [
            {
              "$ref": "diagnosis-report-v3"
            },
            {
              "type": "null"
            }
          ]
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "question_id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "const": "open"
              },
              "answer_summary": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "question_id",
              "question",
              "status",
              "answer_summary"
            ]
          }
        },
        "pending_clarification": {
          "anyOf": [
            {
              "$ref": "#/$defs/pending"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "accepted_facts",
        "prior_report_summary",
        "unresolved_questions",
        "pending_clarification"
      ]
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "enum": [
            "diagnosis-turn-5why-v3",
            "diagnosis-turn-5w-v3",
            "diagnosis-turn-5w2h-v3"
          ]
        },
        "schema_version": {
          "const": "3"
        }
      },
      "required": [
        "schema",
        "schema_version"
      ]
    }
  },
  "required": [
    "request",
    "workspace",
    "metrics",
    "source_manifest",
    "source_records",
    "manual_inputs",
    "missing_or_anomalous_inputs",
    "source_conflicts",
    "period",
    "scope",
    "user_message",
    "continuation_input",
    "session_state",
    "output_contract"
  ],
  "$defs": {
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "industry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cadence": {
          "enum": [
            "day",
            "week",
            "month",
            "quarter",
            "custom"
          ]
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "metric_definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metricDefinition"
          }
        }
      },
      "required": [
        "workspace_id",
        "industry",
        "cadence",
        "timezone",
        "metric_definitions"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "comparable": {
          "type": "boolean"
        },
        "conflict_status": {
          "enum": [
            "none",
            "unresolved",
            "resolved"
          ]
        },
        "resolution_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "value",
        "unit",
        "evidence_ids",
        "comparable",
        "conflict_status",
        "resolution_id"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "conflict_status": {
                "const": "resolved"
              }
            }
          },
          "then": {
            "properties": {
              "resolution_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "resolution_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^cell:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[^:]+:[A-Z]{1,3}[1-9][0-9]*$"
        },
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "file_label": {
          "type": "string",
          "minLength": 1
        },
        "sheet": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "cell_or_row": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}[1-9][0-9]*$"
        },
        "values": {
          "$ref": "#/$defs/sourceCellValues"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "file_label",
        "sheet",
        "cell_or_row",
        "values"
      ]
    },
    "sourceManifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "file_label": {
          "type": "string",
          "minLength": 1
        },
        "sheet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_range": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "source_id",
        "file_label",
        "sheet",
        "selected_range",
        "content_hash",
        "selection_hash"
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "type": "string",
          "format": "uuid"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "up",
            "down",
            "neutral"
          ]
        },
        "target_constraint_scope": {
          "enum": [
            "monthly_revenue_floor",
            "explicit_target_only",
            "none"
          ]
        },
        "explicit_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/candidate"
            },
            {
              "type": "null"
            }
          ]
        },
        "annual_allocated_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/candidate"
            },
            {
              "type": "null"
            }
          ]
        },
        "prior_year_actual": {
          "anyOf": [
            {
              "$ref": "#/$defs/candidate"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "actual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "mom": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/comparison"
                },
                {
                  "properties": {
                    "comparison_type": {
                      "const": "mom"
                    }
                  }
                }
              ]
            }
          ]
        },
        "yoy": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/comparison"
                },
                {
                  "properties": {
                    "comparison_type": {
                      "const": "yoy"
                    }
                  }
                }
              ]
            }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "metric_id",
        "label",
        "unit",
        "direction",
        "target_constraint_scope",
        "explicit_target",
        "annual_allocated_target",
        "prior_year_actual",
        "target",
        "actual",
        "delta",
        "mom",
        "yoy",
        "evidence_ids"
      ]
    },
    "manualInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_id": {
          "type": "string",
          "format": "uuid"
        },
        "metric_id": {
          "type": "string",
          "format": "uuid"
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:[.][0-9]*[1-9])?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmed": {
          "type": "boolean"
        },
        "source_note": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^manual:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:r[1-9][0-9]*$"
          }
        },
        "input_revision": {
          "type": "integer",
          "minimum": 1
        },
        "measure_role": {
          "enum": [
            "actual",
            "plan",
            "annual_month_plan"
          ]
        },
        "period": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_key": {
          "type": "string",
          "minLength": 1
        },
        "raw_text": {
          "type": "string"
        }
      },
      "required": [
        "input_id",
        "metric_id",
        "value",
        "unit",
        "confirmed",
        "source_note",
        "evidence_ids",
        "input_revision",
        "measure_role",
        "period",
        "scope_key",
        "raw_text"
      ]
    },
    "anomaly": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "metric_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "code",
        "metric_id",
        "message",
        "evidence_ids"
      ]
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conflict_id": {
          "type": "string",
          "format": "uuid"
        },
        "metric_id": {
          "type": "string",
          "format": "uuid"
        },
        "measure_role": {
          "enum": [
            "actual",
            "plan",
            "annual_month_plan"
          ]
        },
        "period": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "scope_key": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "candidate_values": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "number"
              },
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "source_label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "value",
              "evidence_id",
              "source_label"
            ]
          }
        },
        "resolution_status": {
          "enum": [
            "unresolved",
            "resolved"
          ]
        },
        "resolution_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_evidence_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution_note": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "conflict_id",
        "metric_id",
        "measure_role",
        "period",
        "scope_key",
        "unit",
        "candidate_values",
        "resolution_status",
        "resolution_id",
        "selected_evidence_id",
        "resolution_note"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "resolution_status": {
                "const": "resolved"
              }
            }
          },
          "then": {
            "properties": {
              "resolution_id": {
                "type": "string",
                "format": "uuid"
              },
              "selected_evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "resolution_note": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "resolution_id": {
                "type": "null"
              },
              "selected_evidence_id": {
                "type": "null"
              },
              "resolution_note": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "reportFact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "fact_status": {
          "enum": [
            "fact",
            "user_report",
            "hypothesis",
            "unknown"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "user_quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "item_id",
        "statement",
        "fact_status",
        "evidence_ids",
        "user_quote"
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "why_needed": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "question_id",
        "question",
        "why_needed",
        "evidence_ids"
      ]
    },
    "pending": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turn_id": {
          "type": "string",
          "minLength": 1
        },
        "user_message": {
          "type": "string"
        },
        "clarification_questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "redirect_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stop_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "turn_id",
        "user_message",
        "clarification_questions",
        "redirect_message",
        "stop_reason"
      ]
    },
    "acceptedFact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1
        },
        "source_turn_id": {
          "type": "string",
          "minLength": 1
        },
        "source_turn_no": {
          "type": "integer",
          "minimum": 1
        },
        "user_quote": {
          "type": "string",
          "minLength": 1
        },
        "normalized_statement": {
          "type": "string",
          "minLength": 1
        },
        "open_question_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
