{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsheng-task-create-v1",
  "title": "Manual task create input v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "analysis_revision_no": {
      "type": "integer",
      "minimum": 1
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mutation_id": {
      "type": "string",
      "format": "uuid"
    },
    "cycle_role": {
      "enum": [
        "review",
        "plan"
      ]
    },
    "source_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "summary": {
          "type": "string"
        },
        "category": {
          "enum": [
            "revenue",
            "cost",
            "efficiency",
            "other"
          ]
        },
        "metric_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "target_value": {
          "$ref": "#/$defs/decimalInput"
        },
        "planned_value": {
          "$ref": "#/$defs/decimalInput"
        },
        "actual_value": {
          "$ref": "#/$defs/decimalInput"
        },
        "current_value": {
          "$ref": "#/$defs/decimalInput"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "mp_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "mp_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "planned_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "due_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "resource_need": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_criteria": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_note": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "category"
      ],
      "minProperties": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "start_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "done_criteria": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "action",
          "owner",
          "start_date",
          "due_date",
          "done_criteria"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "workspace_id",
    "run_id",
    "analysis_revision_no",
    "input_fingerprint",
    "mutation_id",
    "cycle_role",
    "source_note",
    "content",
    "steps"
  ],
  "$defs": {
    "decimalInput": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{0,5}[1-9])?$",
      "not": {
        "const": "-0"
      },
      "description": "Canonical decimal string or null; no exponent/grouping/leading zero/trailing fractional zero/negative zero; at most six fraction digits. Core additionally checks 28 significant digits and declared unit."
    },
    "progressValue": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:(?:0|[1-9][0-9]?)(?:\\.[0-9]?[1-9])?|100)$",
      "description": "Canonical decimal percentage from 0 through 100 inclusive, at most two fraction digits; null only in auto mode."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "content": {
            "required": [
              "target_value"
            ],
            "properties": {
              "target_value": {
                "type": "string"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source_note": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "content": {
            "required": [
              "planned_value"
            ],
            "properties": {
              "planned_value": {
                "type": "string"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source_note": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "content": {
            "required": [
              "actual_value"
            ],
            "properties": {
              "actual_value": {
                "type": "string"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source_note": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "content": {
            "required": [
              "current_value"
            ],
            "properties": {
              "current_value": {
                "type": "string"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source_note": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  ]
}
